movement YanTurnAround1 {
    face_right
    walk_left * 5
}

movement YanTurnAround2 {
    face_right
    walk_left * 5
    face_down
    walk_down
    face_right
}

movement YanLeave1 {
    face_down
    walk_down
    face_left
    walk_left * 3
}

movement YanLeave2 {
    face_up
    walk_up
    face_left
    walk_left * 3
}

movement YanFaceBack {
    face_right
}

movement YanGoOffscreen {
    face_left
    walk_left * 6
}

script LAYER1_MAINAREA_EventScript_yanbeach {
    lockall
    if (!flag(FLAG_TALKED_YAN_BEACH)) {
        msgbox("(The woman named Yan is standing here.)")
        msgbox("(She is staring blankly into the ocean.)")
        msgbox("Oh?")
        faceplayer
        msgbox("Hey, {PLAYER}.")
        msgbox("Sorry, but would you mind giving me\na moment alone?")
        setflag(FLAG_TALKED_YAN_BEACH)
        applymovement(9, yfaceleft)
        waitmovement(9)
    } else {
        msgbox("The woman is not even acknowledging\nyou.")
        msgbox("But it doesn't seem like she is\nignoring you.")
        msgbox("Rather, it seems she is focusing\non something else so intently that\pshe doesn't even sense you.")
    }
    releaseall
}

movement yfaceleft {
    face_left
}

