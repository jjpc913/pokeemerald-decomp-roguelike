script SCRIPT_BOX_LAYER_1 { 
    lockall
    msgbox("(A box that says 'MART'.)")
    msgbox("(It looks like it contains a bunch\nof goodies.)")
    
    if (flag(FLAG_THIEF)) {
        msgbox("(The seal has been broken and\nshoddily repaired.)")
    }
    
    if (flag(FLAG_LADY_LAYER1) && !flag(FLAG_THIEF)) {
        msgbox("It doesn't seem like the shopkeeper's\naround...")
        msgbox("Did she forget this?")
        msgbox("(...steal something?)", MSGBOX_YESNO)
        if (var(VAR_RESULT) == YES) {
            msgbox("...")
            msgbox("This seems like it might have\nconsequences...")
            msgbox("Are you really sure about this?", MSGBOX_YESNO) 
            if (var(VAR_RESULT) == YES) {
                setflag(FLAG_THIEF)
                msgbox("(You unsealed the box and grabbed\nthe first few things you could see.)")
                call(Rummage_Common)
                call(Rummage_Common)
                call(Rummage_Common)
                call(Rummage_Uncommon)
                call(Rummage_Uncommon)
                call(Rummage_Rare)
                call(Rummage_Rare)
                call(Rummage_Common)
                call(Rummage_Uncommon)
                msgbox("(You hastily tried to reseal the box.)")
                msgbox("(...it won't fully seal, but\nhopefully it's good enough.)")
                msgbox("Better get out of here.")
            }
        }
    }
    releaseall
}

script LAYER1_MAINAREA_EventScript_Lady {
    lockall
    msgbox("Hello, {PLAYER}.")
    msgbox("It is nice to see you.")
    msgbox("I am but a humble shopkeeper.")
    if (flag(FLAG_THIEF)) {
        msgbox("Normally, I would offer to sell\nyou some of my goods.")
        msgbox("However, it appears that they\nhave been stolen.")
        msgbox("What a tragedy...")
        msgbox("I'm sorry, but I won't be able\nto be of any use to you until\pthe criminal is found.")
        msgbox("Once I find them, I will make\nthem pay.")
        msgbox("But for now, I have nothing to\noffer you.")
        msgbox("You wouldn't happen to have seen\nanything, have you?", MSGBOX_YESNO)
        if (var(VAR_RESULT)) {
            msgbox("You have?")
            msgbox("Oh, joyous day.")
            msgbox("With you help, we can bring the\ncriminal to justice.")
            msgbox(".........{PAUSE_UNTIL_PRESS}")
            msgbox("It was you, wasn't it?")
        } else {
            msgbox("Oh, that is a shame.")
            msgbox("If you see anything, please let me know.")
        }
        setflag(FLAG_TALKED_TO_LADY_THIEF)
    } else {
        msgbox("Please, take a look at what I\nhave to offer.")
        pokemart(L1_LADY_MART)
        msgbox("I will be traveling futher soon.")
        msgbox("If you need anything, please see\nme again as soon as possible.")
    }
    releaseall
}

script DIE_THIEF {
    lockall
    if (flag(FLAG_TALKED_TO_LADY_THIEF)) {
        fadeoutbgm(1)
        msgbox("...What, do you think I'm\nstupid?")
        msgbox("I know it was you.")
        msgbox("Who else could it possibly be?")
        msgbox("You've got some real balls\nshowing your face around me.")
        msgbox("Time for retribution.")
        trainerbattle_no_intro(TRAINER_VIVI, LADY_OUTRO)
    }
    releaseall
}

