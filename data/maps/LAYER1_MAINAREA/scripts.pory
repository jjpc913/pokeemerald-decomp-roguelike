raw `LAYER1_MAINAREA_MapScripts::
	.byte 0
`

script LAYER1_MAINAREA_EventScript_Mothman {
    lockall
    if (flag(FLAG_MET_MOTHMAN)) {
        releaseall
        return
    }
    msgbox("..not so fast, buddy!")
    applymovement(1, MothmanMoveRight)
    waitmovement(1)
    msgbox("I couldn't help but notice you were\nabout to wander into the grass\pwithout a care in the world.")
    msgbox("You know the grass is dangerous,\nright?")
    msgbox("I mean, more dangerous than normal.")
    msgbox("This place is special, you see.")
    msgbox("The Pokemon are more aggressive.")
    msgbox("They'll hunt you down before they\nlet you run away.")
    applymovement(1, MothmanMoveOne)
    waitmovement(1)
    msgbox("And even if you do beat 'em, you\nwon't get anything in return.")
    msgbox("You won't find any Pokemon Centers\neither.")
    msgbox("In other words, you should\navoid fights when you can.")
    msgbox("...just a friendly word of advice.")
    applymovement(1, MothmanMoveOne)
    waitmovement(1)
    msgbox("You can call me MOTHMAN.")
    msgbox("I'm your guardian angel, in a way.\nEheheh...")
    msgbox("You can take this.")
    giveitem(ITEM_FULL_HEAL, 1)
    giveitem(ITEM_POTION, 1)
    msgbox("It's brutal out there.")
    msgbox("Good luck, {PLAYER}.\n")
    msgbox("I'll be rooting for you...eheheh.")
    applymovement(1, MothmanFaceLeft)
    waitmovement(1)
    applymovement(1, MothmanMoveLeft)
    waitmovement(1)
    setflag(FLAG_MET_MOTHMAN)
    removeobject(1)
    releaseall
}

movement MothmanMoveRight {
    walk_right * 5
}
movement MothmanMoveOne {
    walk_right
}
movement MothmanFaceLeft {
    face_left
}

movement MothmanMoveLeft {
    walk_left * 8
}

script LAYER1_MAINAREA_EventScript_Lamp {
    lockall
    msgbox("(There is a suspicious looking\nlamp post here.)")
    checkitem(ITEM_RED_SCARF, 1)
    if (var(VAR_RESULT)) {
        msgbox("(The lamp is resonating with your wishing\nstone...)")
        delay(1)
        fadescreen(FADE_TO_WHITE)
        delay(10)
        fadescreen(FADE_FROM_WHITE)
        delay(1)
        msgbox("(The stone feels soft in your hand,\nmalleable like jelly but still\psolid enough to grip.)")
        msgbox("(Would you like to crush a wishing\nstone?)", MSGBOX_YESNO)
        if (var(VAR_RESULT) == YES) {
            msgbox("(You smash the stone against the\nlamp post.)")
            removeitem(ITEM_RED_SCARF, 1)
            delay(1)
            fadescreen(FADE_TO_WHITE)
            delay(10)
            fadescreen(FADE_FROM_WHITE)
            delay(1)
            msgbox("What is your wish?", MSGBOX_DEFAULT)
            dynmultichoice(0,0, FALSE, 4, 0, DYN_MULTICHOICE_CB_NONE, "I wish for power.", 
                "I wish for healing.", "I wish for a better future.", "I wish for wealth.", 
                "I wish for treasure.", "I wish for merciful death.")
            switch(var(VAR_RESULT)) {
                case 0: # power
                    msgbox("(You wished for power.)")
                    giveitem(ITEM_RARE_CANDY, 3)
                case 1: # healing
                    msgbox("(You wished for healing.)")
                    special(HealPlayerParty)
                    msgbox("(Your party was miraculously healed...!)")
                case 2: # cure
                    msgbox("(You wished for a better future.)")
                    giveitem(ITEM_FULL_HEAL, 5)
                    giveitem(ITEM_REVIVE, 1)
                case 3: # wealth
                    msgbox("(You wished for wealth.)")
                    addmoney(5000)
                    msgbox("(Your pockets feel a bit heavier...!)")
                case 4: # treasure
                    msgbox("(You wished for treasure.)")
                    call(Rummage_Uncommon)
                    call(Rummage_Uncommon)
                    call(Rummage_Uncommon)
                    call(Rummage_Rare)
                    call(Rummage_Rare)
                case 5: # death
                    msgbox("(You wished for merciful death.)")
                    msgbox("(....)")
                    msgbox("Is this really what you want?", MSGBOX_YESNO)
                    if (var(VAR_RESULT) == YES) {
                        # death
                        warp(MAP_DEATHZONE, 9,27)
                    } else {
                        msgbox("(You hesitated in your conviction.)")
                        msgbox("(The wish was wasted...)")
                    }
                case MULTI_B_PRESSED:
                    msgbox("(You tripped over your words,\nand the wish failed.)")
            }
        }
    }
    releaseall
}