script LAYER1_MAINAREA_EventScript_Boy1 {
    lockall
    faceplayer
    if (!flag(FLAG_SAD_GUY)) {
        msgbox("..Oh! You...!")
        msgbox("You seem...normal!")
        msgbox("Oh, thank god.")
        checkplayergender
        if (var(VAR_RESULT) == MALE) {
            msgbox("You've gotta help, dude!")
        } else {
            msgbox("You've gotta help, ma'am!")
        }
        msgbox("Um...my name's Dubois.")
        msgbox("I fell down here a while ago...um...\nwas it...two days ago?")
        msgbox("No...more than that...I think.")
        msgbox("Er, anyway, everyone's acting really weird!")
        msgbox("It's like...it's like they all went\ncrazy!")
        msgbox("I can't find how to leave this damn\nplace, either.")
        msgbox("But you...I haven't seen you yet!")
        msgbox("You must've gotten in here somehow!\nHow? How did you do it?")
        msgbox("If you can get in, surely you can\nget out, right?")
        msgbox("H...hello? Why aren't you saying anything?")
        msgbox("Why won't you talk?")
        msgbox("Please...help me!")
        msgbox("Oh god...oh god! Don't tell me...")
        msgbox("Please...I just want to go home...")
        msgbox("...")
        msgbox("(This man is hysterical.)")
        msgbox("(He seems distracted...you could\ntry stealing from him.)", MSGBOX_YESNO)
        if (var(VAR_RESULT) == YES) {
            msgbox("You stole a potion from the mans bag.")
            giveitem(ITEM_POTION, 1)
            addvar(VAR_VENOM, 1)
        } else {
            msgbox("(You decide to be a good person.)")
        }
        setflag(FLAG_SAD_GUY)
    } else {
        msgbox("(This man is hysterical.)")
        msgbox("(Best leave him alone.)")
    }
    releaseall
}

script LAYER1_MAINAREA_EventScript_Sign {
    lockall
    msgbox("'No matter what, never stop dreaming.'")
    releaseall
}
