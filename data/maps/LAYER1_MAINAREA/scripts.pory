script LAYER1_MAINAREA_EventScript_Boy1 {
    lockall
    faceplayer
    if (!flag(FLAG_SAD_GUY)) {
        msgbox("..Oh! You...!")
        msgbox("You seem...normal!")
        msgbox("Oh, thank god.")
        checkplayergender
        if (var(VAR_RESULT) == MALE) {
            msgbox("You've gotta help, dude!")
        } else {
            msgbox("You've gotta help, ma'am!")
        }
        msgbox("Everyone's acting really weird!")
        msgbox("It's like...it's like they all went\ncrazy!")
        msgbox("I can't find how to leave this damn\nplace, either.")
        msgbox("But you...I haven't seen you yet!")
        msgbox("You must've gotten in here somehow!\nHow? How did you do it?")
        msgbox("If you can get in, surely you can\nget out, right?")
        msgbox("H...hello? Why aren't you saying anything?")
        msgbox("Why won't you talk?")
        msgbox("Please...help me!")
        msgbox("Oh god...oh god! Don't tell me...")
        msgbox("Please...I just want to go home...")
        msgbox("...")
        msgbox("(This man is hysterical.)")
        msgbox("(He seems distracted...you could\ntry stealing from him.)", MSGBOX_YESNO)
        if (var(VAR_RESULT) == YES) {
            msgbox("You stole a potion from the mans bag.")
            giveitem(ITEM_POTION, 1)
            addvar(VAR_VENOM, 1)
        } else {
            msgbox("(You decide to be a good person.)")
        }
        setflag(FLAG_SAD_GUY)
    } else {
        msgbox("(This man is hysterical.)")
        msgbox("(Best to leave him alone.)")
    }
    releaseall
}

script LAYER1_MAINAREA_EventScript_Sign {
    lockall
    msgbox("'May your wildest of dreams come true.'")
    releaseall
}

script LAYER1_MAINAREA_EventScript_Yan1 {
    lockall
    if (!flag(FLAG_YAN_1)) {
    msgbox("Hmm?")
    applymovement(8, YanTurnAround1)
    waitmovement(8)
    playbgm(MUS_ENCOUNTER_INTERVIEWER, FALSE)
    faceplayer
    msgbox("Oh, hello there!")
    msgbox("I haven't met you before.")
    msgbox("'Name's Yan.")
    msgbox("You can take this.")
    giveitem(ITEM_BLUE_SCARF, 1)
    msgbox(".....")
    msgbox("Oh...you're {PLAYER}?")
    msgbox("Nice to meetcha!")
    msgbox("I'm a detective currently investigating\nthis strange phenomenon.")
    msgbox("...what, don't tell me you haven't\nseen it?")
    call(RollD20)
    if (var(VAR_RESULT) > 10) {
        msgbox("All these people, gone completely\ncuckoo.")
    } else {
        msgbox("All these people, gone completely\ncrazy.")
    }

    msgbox("I, uh, haven't really made any\nprogress, yet.")
    msgbox("But, young explorer, don't fret.")
    msgbox("I'm going to get to the bottom of this.")
    msgbox("For now, I'm doing some field research.")
    msgbox("There's a small village up ahead,\non the other side of the mountain.")
    msgbox("It's become somewhat of a safe haven.")
    call(RollD20)
    if (var(VAR_RESULT) > 10) {
        msgbox("Don't go dying on me now, alright?")
    } else {
        msgbox("I'll meet you there, 'kay?")
    }
    msgbox("I still have a few more interviews\nto conduct, stones to turn over.")
    call(RollD20)
    if (var(VAR_RESULT) > 10) {
        msgbox("Toodles!")
    } else {
        msgbox("See ya!")
    }
    applymovement(8, YanLeave1)
    waitmovement(8)
    delay(100)
    fadeoutbgm(1)
    msgbox("{PLAYER}...")
    msgbox("Oh, {PLAYER}. One more thing.")
    delay(100)
    msgbox("You haven't...er, how do I\nput this...")
    msgbox("A girl with a face like TV static,\nand her hair jet black.")
    msgbox("You haven't seen anyone like that,\nhave you?")
    dynmultichoice(20,8, FALSE, 4, 0, DYN_MULTICHOICE_CB_NONE, "NO", "NO")
    msgbox("...alright.")
    msgbox("Just curious.")
    call(RollD20)
    if (var(VAR_RESULT) < 7) {
        msgbox(".......")
        msgbox("What a weird feeling.")
        msgbox("You...")
        msgbox("Sorry, ignore me.")
    }
    msgbox("Good luck, {PLAYER}.")
    applymovement(8, YanGoOffscreen)
    waitmovement(8)
    setflag(FLAG_YAN_1)
    removeobject(8)
    fadedefaultbgm
    }
    releaseall
}

