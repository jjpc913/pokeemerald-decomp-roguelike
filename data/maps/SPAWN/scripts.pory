script EnableRunning {
	lockall
	setflag(FLAG_SYS_B_DASH)
	releaseall
}

script Script_Save {
	lockall
	fadescreen(FADE_TO_WHITE)
	delay(5)
	msgbox("You exhale a sigh of relief.")
	special(SaveGame)
	waitstate
	fadescreen(FADE_FROM_WHITE)
	msgbox("It seems like you were asleep\nfor a few hours.")
	releaseall
}

script DISABLEEXP {
	lockall
	setflag(FLAG_DISABLE_EXP)
	releaseall
}
