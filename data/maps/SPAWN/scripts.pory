raw `SPAWN_MapScripts::
	.byte 0
`

script SPAWN_MapScripts_Enable_Permadeath {
	lockall
	setflag(FLAG_PERMADEATH)
	releaseall
}

script SPAWN_MapScripts_Sign {
	lockall
	msgbox("     's House")
	releaseall
}

script SPAWN_MapScripts_Hole {
	lockall
	msgbox("(.........)")
	msgbox("(The hole goes so deep, you can't make\nout anything.)")
	msgbox("(You can hear wind blowing from deep\ninside.)")
	msgbox("(You can tell that, once you jump down,\nyou won't be able to return.)")
	msgbox("Are you sure you are ready?", MSGBOX_YESNO)
	if (var(VAR_RESULT) == YES) {
		fadescreen(FADE_TO_BLACK)
		delay(30)
		msgbox("...one step further into the abyss.")
		delay(30)
		msgbox(".............")
		delay(40)
		msgbox("You've been falling for a long time...")
		delay(10)
		msgbox("........")
		delay(30)
		msgbox("You've been falling for so long, you\nalmost forget the feeling of standing on\pthe ground.")
		delay(20)
		msgbox("...until....")
		delay(5)
		warp(MAP_LANDING_CAVE, 8, 6)
		waitstate
		fadescreen(FADE_FROM_BLACK)
		delay(1)
	}
	releaseall
}

