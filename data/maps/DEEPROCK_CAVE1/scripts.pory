raw `DEEPROCK_CAVE1_MapScripts::
	.byte 0
`

script DEEPROCK_CAVE1_EventScript_Move_Dubois {
    lockall
    if (!flag(FLAG_CAVE_DUBOIS)) {
        applymovement(1, RUNUP_DUBOIS)
        waitmovement(1)
        removeobject(1)
        setflag(FLAG_CAVE_DUBOIS)
        releaseall
    }
    releaseall
}

movement RUNUP_DUBOIS {
    face_up
    walk_up * 3
}

script DEEPROCK_CAVE1_EventScriptDoll {
    lockall
    msgbox("(There is a giant statue of Regirock\nblocking the way.)")
    msgbox("Looking closely, you can see a small\nkey slot.")
    checkitem(ITEM_WELLSPRING_MASK)
    if (var(VAR_RESULT) == TRUE) {
        msgbox("Insert the Rocky Key?", MSGBOX_YESNO)
        if (var(VAR_RESULT) == TRUE) {
            msgbox("You inserted the key into the statue.")
            msgbox("It's disappearing..!")
            setflag(FLAG_CAVE_DOLL)
            removeobject(7)
        }
    }
    releaseall
}

script DEEPROCK_CAVE1_EventScript_Move_Dubois2 {
    lockall
    if (!flag(FLAG_CAVE_DUBOIS2)) {
        applymovement(8, RUNUP_DUBOIS)
        waitmovement(8)
        removeobject(8)
        setflag(FLAG_CAVE_DUBOIS2)
        releaseall
    }
    releaseall
}

script DEEPROCK_CAVE1_EventScript_Ball1 {
    lockall
    call(Rummage_Common)
    setflag(FLAG_CAVE_BALL1)
    removeobject(2)
    releaseall
}

script DEEPROCK_CAVE1_EventScript_Ball3 {
    lockall
    call(Rummage_Uncommon)
    setflag(FLAG_CAVE_BALL3)
    removeobject(4)
    releaseall
}

script DEEPROCK_CAVE1_EventScript_Ball2 {
    lockall
    call(Rummage_Common)
    setflag(FLAG_CAVE_BALL2)
    removeobject(3)
    releaseall
}

script DEEPROCK_CAVE1_EventScript_Hiker2 {
    trainerbattle_single(TRAINER_SAWYER_1, SAWYER_INTRO, Generic_Outro)
    msgbox("Sorry.")
}

text SAWYER_INTRO {
    "I'M HAPPILY SURROUNDED BY HOT PEOPLE\n"
	"AROUND THESE PARTS. I WON'T LOSE!"
}

