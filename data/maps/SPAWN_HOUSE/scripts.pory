script SPAWN_HOUSE_EventScript_TV {
    lockall
    msgbox("The TV is off.")
    releaseall
}

script SPAWN_HOUSE_EventScript_Door {
    lockall
    msgbox("There is a door here, but it's locked.")
    if (flag(FLAG_HAS_KEY)) {
        msgbox("Use SECRET KEY?", MSGBOX_YESNO)
        if (var(VAR_RESULT) == TRUE) {
            msgbox("You slowly open the door...")
        }
    }
    releaseall
}

script SPAWN_HOUSE_EventScript_Mudkip {
    lockall
    if (flag(FLAG_TREECKO) || flag(FLAG_TORCHIC)) {
        msgbox("It's just a doll...")
        releaseall
    } else {
        msgbox("Take Mudkip, the water type?", MSGBOX_YESNO)
        if (var(VAR_RESULT) == YES) {
            givemon(SPECIES_MUDKIP, 10, ITEM_ORAN_BERRY)
            setflag(FLAG_MUDKIP)
            setflag(FLAG_SYS_POKEMON_GET)
            removeobject(3)
        }
    }
    
    releaseall
}

script SPAWN_HOUSE_EventScript_Torchic {
    lockall
    if (flag(FLAG_TREECKO) || flag(FLAG_MUDKIP)) {
        msgbox("It's just a doll...")
        releaseall
    } else {
        msgbox("Take Torchic, the fire type?", MSGBOX_YESNO)
        if (var(VAR_RESULT) == YES) {
            givemon(SPECIES_TORCHIC, 10, ITEM_ORAN_BERRY)
            setflag(FLAG_TORCHIC)
            setflag(FLAG_SYS_POKEMON_GET)
            removeobject(4)
        }
    }
    releaseall
}

script SPAWN_HOUSE_EventScript_Treecko {
    lockall
    if (flag(FLAG_MUDKIP) || flag(FLAG_TORCHIC)) {
        msgbox("It's just a doll...")
        releaseall
    } else {
        msgbox("Take Treecko, the grass type?", MSGBOX_YESNO)
        if (var(VAR_RESULT) == YES) {
            givemon(SPECIES_TREECKO, 10, ITEM_ORAN_BERRY)
            setflag(FLAG_TREECKO)
            setflag(FLAG_SYS_POKEMON_GET)
            removeobject(5)
        }
    }
    releaseall
