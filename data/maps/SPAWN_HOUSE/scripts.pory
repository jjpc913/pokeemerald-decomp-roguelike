raw `SPAWN_HOUSE_MapScripts::
	.byte 0
`

script SPAWN_HOUSE_EventScript_Rose{
    lockall
    faceplayer
    if (!flag(FLAG_TALKED_TO_ROSE)) {
        msgbox("...ah.")
        msgbox("Hello, there.")
        msgbox("Have we met?")
        msgbox("....")
        msgbox("Well, it doesn't matter.")
        msgbox("Don't bother giving me your name.")
        msgbox("I've seen enough like you.")
        msgbox("You've got an arduous journey ahead of\nyou.")
        msgbox("The least I can do is help you get\nstarted.")
    } elif (flag(FLAG_SYS_POKEMON_GET)) {
        msgbox("Ah...good choice.")
        msgbox("You can go ahead and take what\nyou can find from the cabinets too.")
        msgbox("You're gonna need it.")
        releaseall
        return
    } 
    setflag(FLAG_TALKED_TO_ROSE)
    msgbox("Pick your favorite from these Pokemon.")
    msgbox("I'm sure they'll make a useful companion.")
    releaseall
}

script SPAWN_HOUSE_EventScript_Cabinet2 {
    lockall
    msgbox("You rummage through the strange woman's\ncabinet...")
    if (flag(FLAG_CABINET2)) {
        msgbox("...but there's nothing left.")
    } else {
        call(Rummage_Common)
        setflag(FLAG_CABINET2)
    }
}

script SPAWN_HOUSE_EventScript_Cabinet {
    lockall
    msgbox("You rummage through the strange woman's\ncabinet...")
    if (flag(FLAG_CABINET1)) {
