script SPAWN_HOUSE_EventScript_OneMoreThing {
    lockall
    faceplayer
    if (flag(FLAG_SYS_POKEMON_GET) && !flag(FLAG_OMINOUS_MESSAGE)) {
        delay(30)
        msgbox("....hey.")
        msgbox("One more thing, before you go.")
        msgbox("If you happen to see a girl with\npurple hair down there...")
        msgbox("...")
        msgbox("...nevermind.")
        msgbox("Just...don't let her reach the\nbottom.")
        msgbox("I don't care how you do it.")
        msgbox("Under no circumstances can she\nreach the end.")
        msgbox("Got that?")
        msgbox("That's all.")
        msgbox("Good luck, kid.")
        setflag(FLAG_DISABLE_EXP)
        setflag(FLAG_OMINOUS_MESSAGE)
    }
    releaseall
}