raw `PKMNCENTER_MapScripts::
	.byte 0`

script PKMNCENTER_EventScript_PC {
    lockall
    msgbox("(The PC is turned off.)")
    msgbox("There is a thick layer of dust\nover the keyboard.")
    releaseall
}

script PKMNCENTER_EventScript_Healing {
    lockall
    msgbox("(It seems the healing device is\npowered off.)")
    releaseall
}

script PKMNCENTER_EventScript_Map {
    lockall
    msgbox("It's a map of North America.")
    releaseall
}


script PKMNCENTER_EventScript_Yan {
    lockall
    faceplayer

    if (flag(FLAG_KILLED_YAN)) {
        msgbox("(She doesn't respond.)")
        releaseall
        return
    }
    if (!flag(FLAG_TALKED_TO_YAN_PC)) {
        setflag(FLAG_TALKED_TO_YAN_PC)
        setvar(VAR_GIRL_OPTION, 1)
        setvar(VAR_YOU_OPTION, 1)
        msgbox("Oh, hey, {PLAYER}.")
        msgbox("Good to see you again.")
        msgbox("I'm just taking a break...from\ninvestigating.")
        msgbox("Hah...sorry.")
        msgbox("I feel like my body is shutting\ndown or something.")
        msgbox("I'm so tired...hah.")
        msgbox("I'll be staying here for a bit...\nwhile I rest up.")
        msgbox("One of the neighbors might let you take a nap.")
        msgbox("In the meantime, I'd be happy to\ntalk to you about anything.")
        setflag(FLAG_DEFAULT_YAN)
    } else {
        msgbox("Hey, {PLAYER}.")
    }
    msgbox("What'd you want to talk about?")
    if (flag(FLAG_DEFAULT_YAN)) {
        dynmultichoice(0,0, FALSE, 4, 0, DYN_MULTICHOICE_CB_NONE, "Business Card", "Town", "Investigation", "That Girl", "What to Do", "")
    }

    faceplayer
    switch (var(VAR_RESULT)) {
        case 0:
            if (!flag(FLAG_TALKED_BUSINESS_CARD)) {
                msgbox("Ah, the card?")
                msgbox("That's my special business card.")
                msgbox("It even has a watermark!")
                setflag(FLAG_TALKED_BUSINESS_CARD)
            } elif (flag(FLAG_TALKED_BUSINESS_CARD) && !flag(FLAG_TALKED_BUSINESS_CARD_2)) {
                msgbox("Hm?")
                msgbox("What, still on the card?")
                msgbox("Yes, I know it's great.")
                msgbox("You've got good taste, my friend!")
                setflag(FLAG_TALKED_BUSINESS_CARD_2)
            } else {
                msgbox("(Seems there's nothing left to discuss.)")
            }
            releaseall
            face_right
            break
        case 1:
            if (!flag(FLAG_TALKED_ONCE)) {
                msgbox("I found this little town only a\nshort while ago.")
                msgbox("They do give off a vibe that they\ndon't want me here.")
                msgbox("But compared to the others, the\npeople here are nice.")
                msgbox("There's a lot of useful")
                setflag(FLAG_TALKED_ONCE)
            }
            else {
                msgbox("(Seems there's nothing left to discuss.)")
            }
            releaseall
            face_right
            break
        case 2:
            if (!flag(FLAG_TALKED_MAP)) {
            msgbox("Oh, my investigation?")
            msgbox("Er, well...")
            msgbox("Well...it's definitely weird.")
            msgbox("Everyone I've run into has yelled nonsense\nat me before promptly trying to kill me.")
            msgbox("Save for a few exceptions, of course.")
            msgbox("Nobody seems to want to just...talk.")
            msgbox("I'll be honest, {PLAYER}.")
            msgbox("I don't know how far my investigation will go.")
            msgbox("The answers I'm looking for...I'm certain\nthey're here.")
            msgbox("I can feel it.")
            msgbox("East of here, I can sense that's exactly\nwhere I need to go.")
            msgbox("That the answers are waiting for me.")
            msgbox("...some detective, I am, huh?")
            msgbox("Just working off of hunches and gut feelings.")
            msgbox("But it's as good of a lead as any, I guess.")
            msgbox("I'm sure that's where your adventure\nwill take you to as well.")
            msgbox("I do enjoy your company, {PLAYER}, but\nI'll be blunt.")
            msgbox("If it comes down to it...I won't hold\nback.")
            msgbox("What I'm fighting for...is too important.")
            msgbox("...but hopefully it won't\ncome to that, heehee.")
            msgbox("Sorry, I don't mean to frighten you.")
            setflag(FLAG_TALKED_MAP)
            } else {
                msgbox("(Seems like Yan doesn't want to\ncontinue that conversation.)")
            }
            releaseall
            face_right
            break
        case 3:
            if (var(VAR_GIRL_OPTION) == 2 ) {
                msgbox("This OPTION is UNAVAILABLE.")
                addvar(VAR_GIRL_OPTION, 1)
            } elif (var(VAR_GIRL_OPTION) == 3) {
                msgbox("This OPTION IS UNAVAILABLE.\nThis OPTION IS UNAVAILABLE.This\nOPTION IS UNAVAILABLE.This OPTION IS\nUNAVAILABLE.This OPTION IS UNAVAILABLE.")
                addvar(VAR_GIRL_OPTION, 1)
            } elif (var(VAR_GIRL_OPTION) ==4 ) {
                msgbox("This Option is Unavailable.")
                addvar(VAR_GIRL_OPTION, 1)
            }
            elif (var(VAR_GIRL_OPTION) == 5) {
                msgbox("WARNING!\pThe following option will\ndelete all saved data.{PAUSE_UNTIL_PRESS}")
                msgbox("Is it really okay to delete all saved\ndata? This cannot be undone.{PAUSE_UNTIL_PRESS}", MSGBOX_YESNO)
                if (var(VAR_RESULT) == NO) {
                    releaseall
                    face_right
                    break
                }
                msgbox(".........")
                msgbox("...Have it your way.")
                msgbox("'.........huh?")
                msgbox("...a girl?")
                fadescreen(FADE_TO_WHITE)
                delay(10)
                fadescreen(FADE_FROM_WHITE)
                msgbox("I think...I know what you are\ntalking about.")
                msgbox("So, you have seen her.")
                fadescreen(FADE_TO_WHITE)
                delay(10)
                fadescreen(FADE_FROM_WHITE)
                msgbox("That girl in gray.")
                msgbox("That phantom girl who appears in\nmy dreams.")
                msgbox("I see her.")
                msgbox("'Who are you?'")
                msgbox("'What does this all mean?'")
                msgbox("'Who am I?'")
                msgbox("To tell the truth, these are the\nquestions I really want to answer.")
                msgbox("I don't care about all these people, really...")
                msgbox("I just want to be free.")
                fadescreen(FADE_TO_WHITE)
                delay(10)
                fadescreen(FADE_FROM_WHITE)
                msgbox("Help me, {PLAYER}.")
                msgbox("Help me.")
                msgbox("Please...I don't want to be here anymore.")
                msgbox("Please...kill Yan!")
                fadescreen(FADE_TO_WHITE)
                delay(10)
                fadescreen(FADE_FROM_WHITE)
                msgbox("Huh?")
                msgbox("....what was I saying?")
                msgbox("Oh, hey, {PLAYER}.")
                msgbox("What's up?")
                msgbox("Made any progress on the investigation?")
                addvar(VAR_VENOM, 5)
                setvar(VAR_GIRL_OPTION, 99)
            } elif (var(VAR_GIRL_OPTION) == 99) {
                msgbox("(Seems there's nothing left to discuss.)")
                msgbox("...I hope you're satisfied.")
            } else {
                msgbox("This optioin is unavailable.")
                addvar(VAR_GIRL_OPTION, 1)
            }
            
            releaseall
            face_right
            break
        case 4:
                msgbox("To the north theres a forest.")
                msgbox("To the south, there's some kind of bunker.")
                msgbox("To the east, well...")
                msgbox("That's where the light comes from.")
                msgbox("That's where we need to go.")
                msgbox("But it's currently blocked off by some trees.")
                msgbox("Locals have said there's pieces to\na legendary axe in the heart of\pthe forest and the depths of the bunker.")
                msgbox("That's what I'm doing once I'm ready.")
                msgbox("Think you can beat me to it,{PLAYER}?")
                addvar(VAR_YOU_OPTION, 1)
            releaseall
            face_right
            break
        case 5:
            // note to self for future me: For this incredibly bad bit of code, 
            // make sure the most recent instructions are higher up in the if statement.
            msgbox("What to do, eh?")
            msgbox("Hmmmm....")
            break
        case 127:
            msgbox("See you, then!")
            msgbox("Come back if anything happens, alright?")
            releaseall
        applymovement(1, yanfaceright)
        waitmovement(1)

        checkitem(ITEM_DRAGON_FANG, 1)
        if (var(VAR_RESULT) == TRUE) {
            msgbox("..........")
            msgbox("..........")
            msgbox("Would you like to use the Fangblade?", MSGBOX_YESNO)
            if (var(VAR_RESULT)) {
                msgbox("(You pull the blade out and raise\nit towards Yan's neck.)")
                message("Hmm? {PLAYER}? What are....What\nare you d-!")
                waitmessage
                delay(30)
                closemessage
                fadescreen(FADE_TO_BLACK)
                delay(500)
                msgbox("And with that... {PAUSE_UNTIL_PRESS}")
                delay(10)
                msgbox("The{PAUSE 100} story{PAUSE 100} of{PAUSE 100} 'Yan'{PAUSE 100} was{PAUSE 100} over. {PAUSE_UNTIL_PRESS}")
                setflag(FLAG_KILLED_YAN)
                delay(100)
                fadescreen(FADE_FROM_BLACK)
            }
        }

        releaseall
    }
    
}

movement yanfaceright {
    face_down
}

script PKMN_CENTER_WARP {
    lockall
    if (flag(FLAG_KILLED_YAN)) {
        warp(MAP_CLEARING_EVIL, 40, 11)
    } else {
        warp(MAP_CLEARING, 40, 11)
    }
    releaseall
}